@startuml casos-de-uso
title MeAgendaí: Diagrama de Casos de Uso
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "Cliente" as Cliente
actor "Profissional" as Prof
actor "Administrador" as Admin
actor "Visitante" as Visitante

rectangle "MeAgendaí" {
  usecase "UC01 Cadastrar-se" as UC01
  usecase "UC02 Autenticar-se" as UC02
  usecase "UC03 Consultar serviços" as UC03
  usecase "UC04 Consultar horários livres" as UC04
  usecase "UC05 Agendar serviço" as UC05
  usecase "UC06 Cancelar agendamento" as UC06
  usecase "UC07 Remarcar agendamento" as UC07
  usecase "UC08 Ver meus agendamentos" as UC08
  usecase "UC09 Ver agenda" as UC09
  usecase "UC10 Registrar atendimento\n(realizado/falta)" as UC10
  usecase "UC11 Manter serviços" as UC11
  usecase "UC12 Manter profissionais" as UC12
  usecase "UC13 Manter jornada" as UC13
  usecase "UC14 Visualizar painel" as UC14
  usecase "UC15 Gerenciar agendamentos" as UC15
  usecase "UC16 Zerar faltas do cliente" as UC16
  usecase "UC17 Configurar regras" as UC17
}

Visitante --> UC01
Visitante --> UC03
Cliente --|> Visitante

Cliente --> UC02
Cliente --> UC05
Cliente --> UC06
Cliente --> UC07
Cliente --> UC08
Prof --> UC02
Prof --> UC09
Prof --> UC10
Admin --> UC02
Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC14
Admin --> UC15
Admin --> UC16
Admin --> UC17
Admin --> UC10

UC05 ..> UC04 : <<include>>
UC07 ..> UC04 : <<include>>
UC07 ..> UC06 : <<include>>
UC12 <.. UC13 : <<extend>>
@enduml
